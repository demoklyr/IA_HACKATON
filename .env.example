# Copier ce fichier vers .env puis renseigner les clés nécessaires.
OPENAI_API_KEY=
DISCOVERY_MODEL=openai:gpt-4.1-mini
# mock = demo offline, google = Google results filtered to Instagram Reels,
# web = OpenAI hosted web search, instagram = direct Instagram URL fetch
DISCOVERY_SEARCH_PROVIDER=google
DISCOVERY_SEARCH_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
